#!/bin/bash
# Publishes to the AUR each recipe whose AUR repository is behind this
# repository, with aur-publish, under the SSH key in the environment variable
# AUR_SSH_KEY. The build workflow, .github/workflows/build.yml, runs it on
# main after every recipe has built.
#
#   AUR_SSH_KEY=... ci/publish-aur [--dry-run] [NEW...]
#
# publish-aur looks at every recipe, the directories that hold a PKGBUILD,
# and compares the history aur-publish would push, git subtree split
# --prefix DIR, with the AUR repository's master, read with git ls-remote:
#
#   - When they are the same, the AUR is up to date, and it pushes nothing.
#   - When the AUR's master is an ancestor of the split, the push is a
#     fast-forward, and it runs aur-publish DIR.
#   - When the AUR holds commits the split lacks, it pushes nothing for that
#     recipe, prints a warning, and goes on with the others, since only a
#     person can tell which history is right.
#   - When the AUR has no repository of that name, it runs aur-publish DIR,
#     whose first push creates the repository, only if DIR is one of NEW.
#     The build workflow names in NEW the recipes that the push changed, and
#     the ones a person names when starting the workflow by hand.
#
# So a run publishes whatever an earlier run missed, whether GitHub
# cancelled that run, its gate failed, or one push failed. publish-aur tries
# every recipe, and fails at the end if aur-publish failed for any of them.
# A recipe whose AUR history differs makes a warning, not a failure.
#
# AUR_SSH_KEY holds a private key with no passphrase, whose public half the
# AUR account that maintains the packages lists. publish-aur loads it into
# an ssh-agent of its own and unsets the variable, so that neither
# aur-publish nor git sees the key itself, and it prints the key's
# fingerprint, which is no secret, so that a refused push can be compared
# with the keys the AUR account lists. ssh checks the AUR's host key against
# ci/aur.known_hosts alone, the keys whose fingerprints the AUR publishes on
# https://aur.archlinux.org.
#
# The recipes go one at a time, each terminfo recipe after the others: the
# AUR gives each package name to one AUR repository, and vtium-terminfo was
# built by the vtium recipe before it had a recipe of its own, so vtium
# gives up the name before vtium-terminfo takes it.
#
# --dry-run needs no key: it runs aur-publish --dry-run for each recipe it
# would publish. PUBLISH_AUR_REMOTE, such as file:///tmp/aur/%s.git, names
# where publish-aur reads each AUR repository's master, with %s for the
# recipe, so that a test can stand in for the AUR; aur-publish still names
# the AUR itself.
set -euo pipefail

die() {
	printf 'publish-aur: %s\n' "$*" >&2
	exit 1
}
dry=
if [ "${1-}" = --dry-run ]; then
	dry=1
	shift
fi
declare -A new=()
for d in "$@"; do new[${d%/}]=1; done

top=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$top"

# Every recipe, each terminfo recipe last.
mapfile -t order < <(for f in */PKGBUILD; do echo "${f%/PKGBUILD}"; done | LC_ALL=C sort |
	awk '/-terminfo(-git)?$/ { last[++n] = $0; next } { print } END { for (i = 1; i <= n; i++) print last[i] }')

# What each recipe needs, decided before anything is pushed.
push=() failed=() diverged=()
for d in "${order[@]}"; do
	if ! split=$(git subtree split --prefix "$d" HEAD 2>/dev/null); then
		echo "::error::git subtree split --prefix $d failed"
		failed+=("$d")
		continue
	fi
	# shellcheck disable=SC2059 # the remote's template is the format
	if ! aur=$(git ls-remote "$(printf "${PUBLISH_AUR_REMOTE:-https://aur.archlinux.org/%s.git}" "$d")" refs/heads/master); then
		echo "::error::git ls-remote of the AUR repository $d failed"
		failed+=("$d")
		continue
	fi
	aur=${aur%%[[:space:]]*}
	if [ -z "$aur" ]; then
		if [ -n "${new[$d]-}" ]; then
			echo "publish-aur: $d has no AUR repository yet, and this run creates it."
			push+=("$d")
		else
			echo "publish-aur: $d has no AUR repository yet; a run creates it once a push changes $d, or when someone names it in the input create."
		fi
	elif [ "$aur" = "$split" ]; then
		echo "publish-aur: $d is up to date on the AUR at ${aur:0:7}."
	elif git merge-base --is-ancestor "$aur" "$split" 2>/dev/null; then
		echo "publish-aur: $d moves on the AUR from ${aur:0:7} to ${split:0:7}."
		push+=("$d")
	else
		echo "::warning::The AUR repository $d holds commits that this repository's history of $d lacks: its master is ${aur:0:7}, which is not an ancestor of ${split:0:7}. publish-aur pushes nothing for $d; a person decides which history is right."
		diverged+=("$d")
	fi
done

if [ ${#push[@]} -gt 0 ] && [ -z "$dry" ]; then
	[ -n "${AUR_SSH_KEY-}" ] ||
		die "AUR_SSH_KEY is unset or empty, so nothing can be pushed to the AUR; the maintainer sets it as a secret of this repository"
	known_hosts=$top/ci/aur.known_hosts
	[ -s "$known_hosts" ] || die "ci/aur.known_hosts is missing or empty"
	eval "$(ssh-agent -s)" >/dev/null
	trap 'ssh-agent -k >/dev/null 2>&1 || true' EXIT
	printf '%s\n' "$AUR_SSH_KEY" | ssh-add -q - 2>/dev/null ||
		die "AUR_SSH_KEY is not a private key that ssh-add can load without a passphrase"
	echo "publish-aur: offering the key $(ssh-add -l)"
	export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$known_hosts -o GlobalKnownHostsFile=/dev/null"
fi
unset AUR_SSH_KEY

for d in "${push[@]}"; do
	echo "::group::aur-publish ${dry:+--dry-run }$d"
	if ./aur-publish ${dry:+--dry-run} "$d"; then
		echo "::endgroup::"
	else
		echo "::endgroup::"
		echo "::error::aur-publish $d failed"
		failed+=("$d")
	fi
done

verb=published
[ -z "$dry" ] || verb="would publish"
echo "publish-aur: $verb: ${push[*]:-none}; AUR history differs: ${diverged[*]:-none}; failed: ${failed[*]:-none}."
[ ${#failed[@]} = 0 ] || die "these recipes did not reach the AUR: ${failed[*]}"
