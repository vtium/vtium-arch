#!/bin/bash
# Tests aur-publish's refusals and its signature check in a scratch clone of
# this repository, with a scratch source repository and scratch keys, and
# pushes nothing: every case runs aur-publish --dry-run.
#
#   ./test-aur-publish
#
# git reads no configuration of the user's (GIT_CONFIG_GLOBAL=/dev/null), so
# no commit or tag here is signed with the user's key, and gpg runs in a
# keyring of the test's own whose keys have no passphrase and whose agent
# asks for none, so no passphrase prompt ever opens.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
tmp=$(mktemp -d)
keys=$tmp/gnupg
cleanup() {
	gpgconf --homedir "$keys" --kill all >/dev/null 2>&1 || true
	rm -rf -- "$tmp"
}
trap cleanup EXIT
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
unset VTIUM_GIT_URL VTIUM_GIT_BRANCH VTIUM_FEATURES

fails=0
# expect WANT CASE ARGS...: runs aur-publish --dry-run ARGS in the clone and
# checks that it passes (WANT is "pass") or refuses with WANT in its message.
expect() {
	local want=$1 case=$2 out code=0
	shift 2
	out=$(cd "$tmp/clone" && ./aur-publish --dry-run "$@" 2>&1) || code=$?
	if [ "$want" = pass ]; then
		if [ "$code" = 0 ] && grep -q 'the push, not run' <<<"$out"; then echo "ok   $case"; return; fi
	elif [ "$code" != 0 ] && grep -qF -- "$want" <<<"$out"; then
		echo "ok   $case"
		return
	fi
	echo "FAIL $case: wanted ${want@Q}, got exit $code:"
	sed 's/^/       /' <<<"$out"
	fails=$((fails + 1))
}

# Two scratch keys with no passphrase: the one vtium's recipe names, and
# another.
mkdir -m 0700 "$keys"
printf 'pinentry-mode loopback\n' >"$keys/gpg.conf"
printf 'allow-loopback-pinentry\n' >"$keys/gpg-agent.conf"
for name in signer other; do
	GNUPGHOME=$keys gpg --batch --quiet --passphrase '' --quick-generate-key "$name <$name@example.com>" ed25519 sign never 2>/dev/null
done
fpr() { GNUPGHOME=$keys gpg --batch --with-colons --list-keys "$1@example.com" | awk -F: '$1 == "fpr" { print $10; exit }'; }
signer=$(fpr signer)
other=$(fpr other)

# The scratch source the release recipe builds from.
git init -q -b main "$tmp/src"
git -C "$tmp/src" commit -q --allow-empty -m "a commit to tag"
tag=v0.0.1-test

# The clone, its vtium recipe pointed at the scratch source and key.
git clone -q "$here" "$tmp/clone"
cd "$tmp/clone"
rm -f vtium/keys/pgp/*.asc
GNUPGHOME=$keys gpg --batch --armor --export "$signer" >"vtium/keys/pgp/$signer.asc"
sed -i -e "s|^_tag=.*|_tag=$tag|" \
	-e "s|^source=.*|source=(\"vtium::git+file://$tmp/src#tag=\${_tag}?signed\")|" \
	-e "s|^validpgpkeys=.*|validpgpkeys=('$signer')|" vtium/PKGBUILD
(cd vtium && makepkg --printsrcinfo >.SRCINFO)
git add -A vtium
git commit -q -m "point the release recipe at the scratch source and key"

expect pass "vtium-git passes" vtium-git
expect "which has no such tag yet" "a release whose tag is missing is refused" vtium

git -C "$tmp/src" tag "$tag"
expect "a lightweight tag, which carries no signature" "a lightweight tag is refused" vtium
git -C "$tmp/src" tag -d "$tag" >/dev/null

git -C "$tmp/src" tag -a -m "unsigned" "$tag"
expect "carries no good signature" "an unsigned tag is refused" vtium
git -C "$tmp/src" tag -d "$tag" >/dev/null

GNUPGHOME=$keys git -C "$tmp/src" -c gpg.program=gpg tag -s -u "$other" -m "signed by another key" "$tag"
expect "carries no good signature by a key in vtium/keys/pgp" "a tag signed by a key the recipe does not name is refused" vtium
git -C "$tmp/src" tag -d "$tag" >/dev/null

GNUPGHOME=$keys git -C "$tmp/src" -c gpg.program=gpg tag -s -u "$signer" -m "signed by the recipe's key" "$tag"
expect pass "a tag signed by the recipe's key passes" vtium

# The key the recipe names must be in keys/pgp.
git rm -q "vtium/keys/pgp/$signer.asc"
git commit -q -m "drop the key file"
expect "holds no vtium/keys/pgp/$signer.asc" "a recipe without its key file is refused" vtium
git reset -q --hard HEAD~1

# The steps both recipes share must stay the same.
echo "# a change in one recipe alone" >>vtium/PKGBUILD
git commit -q -am "drift"
expect "differ; make them the same in both" "shared steps that differ are refused" vtium-git
git reset -q --hard HEAD~1

# What is pushed is what is committed, and .SRCINFO follows the PKGBUILD.
echo "# uncommitted" >>vtium-git/PKGBUILD
expect "has changes that are not committed" "an uncommitted change is refused" vtium-git
git checkout -q vtium-git/PKGBUILD
sed -i 's/^pkgrel=1/pkgrel=2/' vtium-git/PKGBUILD
git commit -q -am "a stale .SRCINFO"
expect "is not what makepkg --printsrcinfo prints" "a stale .SRCINFO is refused" vtium-git

if [ "$fails" = 0 ]; then
	echo "test-aur-publish: every case passed"
else
	echo "test-aur-publish: $fails case(s) failed" >&2
	exit 1
fi
