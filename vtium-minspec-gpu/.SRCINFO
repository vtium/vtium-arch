pkgbase = vtium-minspec-gpu
	pkgdesc = Terminal for the Linux console, drawn through KMS/DRM: the smallest build with the GPU path, and no pictures
	pkgver = 0.1.0alpha.5
	pkgrel = 1
	url = https://github.com/vtium/vtium
	install = vtium-minspec-gpu.install
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	makedepends = libxkbcommon
	makedepends = systemd-libs
	depends = glibc
	depends = libgcc
	depends = libxkbcommon
	depends = systemd-libs
	depends = vtium-terminfo
	optdepends = libglvnd: libEGL.so.1, which the GPU path loads when hwaccel is on
	optdepends = mesa: libgbm.so.1, which the GPU path loads, and the EGL driver for most cards
	optdepends = vtium-fonts: the fonts the shipped frits name
	optdepends = kbd: console fonts, which vtium draws when no frit is set
	optdepends = kmscon-terminfo: the terminfo entry kmscon, for sessions run with term=kmscon
	provides = vtium=0.1.0alpha.5
	conflicts = vtium
	options = !debug
	backup = etc/vtium/fonts/minspec-16.vtfrit
	backup = etc/vtium/fonts/minspec-8.vtfrit
	source = vtium::git+https://github.com/vtium/vtium.git#tag=v0.1.0-alpha.5?signed
	validpgpkeys = 33F9B54FD2A4B6A4110749B3BA464FC9847A832A
	sha256sums = SKIP

pkgname = vtium-minspec-gpu
