# Maintainer: Aaron Bockelie <aaronsb@gmail.com>
#
# vtium's smallest console with the GPU path, built from a release tag: the
# minspec build with the feature gpu alone, for a single-board computer, a
# server's console or a kiosk whose GPU is worth using (ADR-1500 D8). It
# draws no pictures. hwaccel is off, so the console draws on the CPU until
# a line hwaccel in /etc/vtium/vtium.conf turns the GPU path on. The
# maintainer signs the tag with the PGP key in validpgpkeys, and makepkg
# checks the tag's signature before it builds. Import the key once:
# gpg --import keys/pgp/*.asc, or
# gpg --recv-keys 33F9B54FD2A4B6A4110749B3BA464FC9847A832A.
#
# vtium-minspec-gpu provides vtium and conflicts with it, so a machine holds
# one console package at a time, and a package that depends on vtium is met
# by this one too. vtium's terminfo entry comes from the vtium-terminfo
# package. The GPU path loads libEGL.so.1 and libgbm.so.1 when it makes a GL
# context and links neither, so the package lists their packages as
# optional, and the console draws on the CPU on a machine without them.
#
# pkgver is the tag without its v and without the hyphen before a
# pre-release: v0.1.0-alpha.1 is 0.1.0alpha.1, which pacman sorts before
# 0.1.0 (vercmp).

pkgname=vtium-minspec-gpu
_tag=v0.1.0-alpha.8
pkgver=0.1.0alpha.8
pkgrel=1
pkgdesc='Terminal for the Linux console, drawn through KMS/DRM: the smallest build with the GPU path, and no pictures'
arch=('x86_64')
url='https://github.com/vtium/vtium'
# vtium is MIT. The console also builds in the Unifont font (OFL-1.1),
# tables made from Unicode's data (Unicode-3.0) and X.Org's color names
# (MIT-open-group and MIT), which COPYING lists.
license=('MIT' 'OFL-1.1' 'Unicode-3.0' 'MIT-open-group')
depends=('glibc' 'libgcc' 'libxkbcommon' 'systemd-libs' 'vtium-terminfo')
makedepends=('cargo' 'git')
optdepends=('libglvnd: libEGL.so.1, which the GPU path loads when hwaccel is on'
            'mesa: libgbm.so.1, which the GPU path loads, and the EGL driver for most cards'
            'vtium-fonts: the fonts the shipped frits name'
            'kbd: console fonts, which vtium draws when no frit is set'
            'kmscon-terminfo: the terminfo entry kmscon, for sessions run with term=kmscon')
provides=("vtium=$pkgver")
conflicts=('vtium')
# The frits _make names in FRITS, which keep a user's edits across an
# upgrade (ADR-1500 D8).
backup=('etc/vtium/fonts/minspec-16.vtfrit'
        'etc/vtium/fonts/minspec-8.vtfrit')
install=vtium-minspec-gpu.install
options=('!debug')
source=("vtium::git+https://github.com/vtium/vtium.git#tag=${_tag}?signed")
sha256sums=('SKIP')
validpgpkeys=('33F9B54FD2A4B6A4110749B3BA464FC9847A832A') # Aaron Bockelie <aaronsb@gmail.com>

# Everything below is the same in vtium-minspec-gpu-git/PKGBUILD and
# vtium-minspec-gpu/PKGBUILD; aur-publish refuses a package whose copy
# differs from the other's.

prepare() {
  cd vtium
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

# vtium's Makefile builds and stages every file the package ships, so which
# file goes where lives in vtium's tree (ADR-1500 D1, D3). Each call names
# the same build, so make install in package() finds the build that build()
# made, and builds nothing again:
#
#   - PREFIX=/usr, so the console starts its glyph helper at
#     /usr/bin/vtium-config.
#   - FEATURES, the console's features: gpu alone, while VTIUM_FEATURES is
#     unset in makepkg's environment (ADR-1500 D2, D8). VTIUM_FEATURES names
#     other features, and set but empty, as in VTIUM_FEATURES= makepkg, it
#     names none, so the console is the minspec build with no GPU path.
#     Whatever it names, the package's dependencies and the two settings
#     below stay those of the default build.
#   - HWACCEL=off and DISPLAY_BUFFERS=2, the defaults the console and
#     vtium-config read for hwaccel and display-buffers (ADR-1500 D8). The
#     console draws on the CPU until hwaccel in /etc/vtium/vtium.conf turns
#     the GPU path on, and keeps two buffers for each display.
#   - FRITS, the frits make install stages into /etc/vtium/fonts, which the
#     package's backup list names.
#   - --frozen, because prepare() fetched the crates.
_make() {
  CARGO_TARGET_DIR=target make -C "$srcdir/vtium" PREFIX=/usr \
    FEATURES="${VTIUM_FEATURES-gpu}" HWACCEL=off \
    DISPLAY_BUFFERS=2 FRITS='minspec-16 minspec-8' \
    CARGO_BUILD_FLAGS=--frozen "$@"
}

# The console, built with vtium's minspec profile, and its glyph helper.
build() {
  _make install-build
}

# The console, its helper, its units vtium@.service and vtium-getty@.service,
# the example configuration /etc/vtium/vtium.conf.example, the frits in
# /etc/vtium/fonts, the example udev rules and hwdb fragment, and LICENSE.
# The recipe installs COPYING and the two license texts it points to beside
# LICENSE itself, so that a package built from a tag whose make install
# stages LICENSE alone still carries them. COPYING holds the notices for the
# third-party code and data vtium builds in, such as Unicode's data tables,
# whose license asks that its notice go with every copy. OFL-1.1.txt is the
# SIL Open Font License of the Unifont font, which asks that its text go
# with the font, and rgb-license.txt is the license of X.Org's color names.
package() {
  _make install DESTDIR="$pkgdir" PKGNAME="$pkgname"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/vtium/COPYING" \
    "$srcdir/vtium/crates/vtium-font/data/OFL-1.1.txt" \
    "$srcdir/vtium/crates/vtium-term/gen-color-names/src/rgb-license.txt"
}
