# Maintainer: Aaron Bockelie <aaronsb@gmail.com>
#
# vtium's smallest console with the GPU path, built from the tip of a git
# branch, GitHub's main by default: the minspec build with the feature gpu
# alone, and hwaccel off (ADR-1500 D8). It differs from vtium-minspec-gpu
# only in its source and its version. vtium-minspec-gpu-git provides vtium
# and conflicts with it, so a machine holds one console package at a time,
# and a package that depends on vtium is met by this one too. vtium's
# terminfo entry comes from the vtium-terminfo-git package. The GPU path
# loads libEGL.so.1 and libgbm.so.1 when it makes a GL context and links
# neither, so their packages are optional.
#
# VTIUM_GIT_URL and VTIUM_GIT_BRANCH point the build at another repository
# and branch, such as a local checkout:
#
#   VTIUM_GIT_URL=file:///path/to/vtium VTIUM_GIT_BRANCH=my-branch makepkg -f
#
# .SRCINFO is made with none of them set, so it always names GitHub's main.
# The source is not checked against a signature: main's tip is a merge
# commit that GitHub signs with its own key.

pkgname=vtium-minspec-gpu-git
pkgver=0.1.0alpha.5.r0.g2f54fa7
pkgrel=1
pkgdesc='Terminal for the Linux console, drawn through KMS/DRM: the smallest build with the GPU path, and no pictures (git main)'
arch=('x86_64')
url='https://github.com/vtium/vtium'
license=('MIT')
depends=('glibc' 'libgcc' 'libxkbcommon' 'systemd-libs' 'vtium-terminfo-git')
makedepends=('cargo' 'git')
optdepends=('libglvnd: libEGL.so.1, which the GPU path loads when hwaccel is on'
            'mesa: libgbm.so.1, which the GPU path loads, and the EGL driver for most cards'
            'vtium-fonts: the fonts the shipped frits name'
            'kbd: console fonts, which vtium draws when no frit is set'
            'kmscon-terminfo: the terminfo entry kmscon, for sessions run with term=kmscon')
provides=("vtium=$pkgver")
conflicts=('vtium')
# The frits _make names in FRITS, which keep a user's edits across an
# upgrade (ADR-1500 D8).
backup=('etc/vtium/fonts/minspec-16.vtfrit'
        'etc/vtium/fonts/minspec-8.vtfrit')
install=vtium-minspec-gpu-git.install
options=('!debug')
source=("vtium::git+${VTIUM_GIT_URL:-https://github.com/vtium/vtium.git}#branch=${VTIUM_GIT_BRANCH:-main}")
sha256sums=('SKIP')

pkgver() {
  cd vtium
  # The last version tag, with the hyphen before a pre-release dropped
  # (v0.1.0-alpha.1 is 0.1.0alpha.1, as the vtium package names it), then
  # .r<commits since>.g<hash>. Before vtium has a tag, r<commits>.<hash>.
  if git describe --long --tags --match 'v[0-9]*' --abbrev=7 >/dev/null 2>&1; then
    git describe --long --tags --match 'v[0-9]*' --abbrev=7 |
      sed 's/^v//;s/^\([0-9.]*\)-\([a-z]\)/\1\2/;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

# Everything below is the same in vtium-minspec-gpu-git/PKGBUILD and
# vtium-minspec-gpu/PKGBUILD; aur-publish refuses a package whose copy
# differs from the other's.

prepare() {
  cd vtium
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

# vtium's Makefile builds and stages every file the package ships, so which
# file goes where lives in vtium's tree (ADR-1500 D1, D3). Each call names
# the same build, so make install in package() finds the build that build()
# made, and builds nothing again:
#
#   - PREFIX=/usr, so the console starts its glyph helper at
#     /usr/bin/vtium-config.
#   - FEATURES, the console's features: gpu alone, while VTIUM_FEATURES is
#     unset in makepkg's environment (ADR-1500 D2, D8). VTIUM_FEATURES names
#     other features, and set but empty, as in VTIUM_FEATURES= makepkg, it
#     names none, so the console is the minspec build with no GPU path.
#     Whatever it names, the package's dependencies and the two settings
#     below stay those of the default build.
#   - HWACCEL=off and DISPLAY_BUFFERS=2, the defaults the console and
#     vtium-config read for hwaccel and display-buffers (ADR-1500 D8). The
#     console draws on the CPU until hwaccel in /etc/vtium/vtium.conf turns
#     the GPU path on, and keeps two buffers for each display.
#   - FRITS, the frits make install stages into /etc/vtium/fonts, which the
#     package's backup list names.
#   - --frozen, because prepare() fetched the crates.
_make() {
  CARGO_TARGET_DIR=target make -C "$srcdir/vtium" PREFIX=/usr \
    FEATURES="${VTIUM_FEATURES-gpu}" HWACCEL=off \
    DISPLAY_BUFFERS=2 FRITS='minspec-16 minspec-8' \
    CARGO_BUILD_FLAGS=--frozen "$@"
}

# The console, built with vtium's minspec profile, and its glyph helper.
build() {
  _make install-build
}

# The console, its helper, its units vtium@.service and vtium-getty@.service,
# the example configuration /etc/vtium/vtium.conf.example, the frits in
# /etc/vtium/fonts, the example udev rules and hwdb fragment, the head
# file's template, and the license.
package() {
  _make install DESTDIR="$pkgdir" PKGNAME="$pkgname"
}
