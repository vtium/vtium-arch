pkgbase = vtium-minspec-git
	pkgdesc = Terminal for the Linux console, drawn through KMS/DRM: the smallest build, with no pictures and no GPU path (git main)
	pkgver = 0.1.0alpha.5.r0.g2f54fa7
	pkgrel = 1
	url = https://github.com/vtium/vtium
	install = vtium-minspec-git.install
	arch = x86_64
	license = MIT
	license = OFL-1.1
	license = Unicode-3.0
	license = MIT-open-group
	makedepends = cargo
	makedepends = git
	depends = glibc
	depends = libgcc
	depends = libxkbcommon
	depends = systemd-libs
	depends = vtium-terminfo-git
	optdepends = vtium-fonts: the fonts the shipped frits name
	optdepends = kbd: console fonts, which vtium draws when no frit is set
	optdepends = kmscon-terminfo: the terminfo entry kmscon, for sessions run with term=kmscon
	provides = vtium=0.1.0alpha.5.r0.g2f54fa7
	conflicts = vtium
	options = !debug
	backup = etc/vtium/fonts/minspec-16.vtfrit
	backup = etc/vtium/fonts/minspec-8.vtfrit
	source = vtium::git+https://github.com/vtium/vtium.git#branch=main
	sha256sums = SKIP

pkgname = vtium-minspec-git
