#!/bin/bash
# Tests what each console package's install script runs and the messages it
# prints, against a scratch /etc/systemd/system and /var/lib/vtium, a
# stand-in systemctl and a stand-in vtium, and changes nothing on this
# machine: each function runs with the script's /etc/systemd and
# /var/lib/vtium paths rewritten to the scratch root's. The stand-in vtium
# takes only the words the script may give it, vtium console enable
# --direct --all and vtium console disable --all, and exits 2 on any
# others, as the real one does on words it cannot take. It records each call and answers with
# the output and exit status a case sets: the real vtium console prints its
# result on standard output, and a refusal on standard error with status 1.
#
#   ./test-install-messages

# The conditions given to check are in single quotes, so that check, not
# the caller, expands them.
# shellcheck disable=SC2016
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
fails=0

# run SCRIPT FUNCTION: the function's output, standard error included, with
# the scratch root's paths printed as the machine's, and then a line
# "status N" with the function's exit status. pacman runs each function
# with no set -e.
run() {
	sed -e "s|/etc/systemd|$tmp/root/etc/systemd|g" -e "s|/var/lib/vtium|$tmp/root/var/lib/vtium|g" "$1" >"$tmp/inst"
	PATH=$tmp/bin:$PATH bash -c ". '$tmp/inst'; $2; echo \"status \$?\"" 2>&1 | sed "s|$tmp/root||g"
}
# calls: the stand-in vtium's calls since the last reset, one a line.
calls() { cat "$tmp/calls" 2>/dev/null || true; }
# answer STATUS OUT ERR: what the stand-in vtium console prints on standard
# output and standard error, and the status it exits with.
answer() {
	printf '%s\n' "$1" >"$tmp/vtium-status"
	printf '%s' "$2" >"$tmp/vtium-out"
	printf '%s' "$3" >"$tmp/vtium-err"
}
# expect CASE OUTPUT WANT...: each WANT is a line OUTPUT holds; a WANT that
# starts with ! is a line it must not hold.
expect() {
	local case=$1 out=$2 w bad=
	shift 2
	for w in "$@"; do
		if [[ $w == !* ]]; then
			! grep -qxF -- "${w#!}" <<<"$out" || bad+=" holds ${w#!@Q}"
		else
			grep -qxF -- "$w" <<<"$out" || bad+=" lacks ${w@Q}"
		fi
	done
	if [ -z "$bad" ]; then echo "ok   $case"; else echo "FAIL $case:$bad"; printf '       %s\n' "${out//$'\n'/$'\n'       }"; fails=$((fails + 1)); fi
}
reset() {
	rm -rf "${tmp:?}/root" "${tmp:?}/bin" "${tmp:?}/calls"
	mkdir -p "$tmp/root/etc/systemd/system/getty.target.wants" "$tmp/bin"
	printf '#!/bin/sh\n' >"$tmp/bin/systemctl"
	cat >"$tmp/bin/vtium" <<-EOF
	#!/bin/bash
	printf '%s\\n' "\$*" >>'$tmp/calls'
	case "\$*" in
	'console enable --direct --all' | 'console disable --all') ;;
	*) echo "vtium: the install script may not run vtium \$*" >&2; exit 2 ;;
	esac
	cat '$tmp/vtium-out'
	cat '$tmp/vtium-err' >&2
	exit "\$(cat '$tmp/vtium-status')"
	EOF
	chmod +x "$tmp/bin/systemctl" "$tmp/bin/vtium"
	answer 0 "" ""
}
link() { ln -s "/usr/lib/systemd/system/$1" "$tmp/root/etc/systemd/system/$2"; }

# Every console package's install script.
scripts=("$here"/*/*.install)
for script in "${scripts[@]}"; do
	name=${script#"$here/"}
	reset
	expect "$name: nothing left, nothing said" "$(run "$script" post_remove)" "!==> If pacman removed this package to install another vtium console package,"

	# The template link and VT 1 given to vtium, by vtium console enable --all
	# or by hand, with no records.
	reset
	link vtium@.service autovt@.service
	link vtium@.service autovt@tty1.service
	link vtium@.service getty.target.wants/vtium@tty1.service
	expect "$name: the template link and VT 1 are named, with the way back" "$(run "$script" post_remove)" \
		"      sudo rm /etc/systemd/system/autovt@.service" \
		"      sudo rm /etc/systemd/system/autovt@tty1.service" \
		"      sudo rm /etc/systemd/system/getty.target.wants/vtium@tty1.service" \
		"      sudo systemctl preset getty@.service" \
		"      sudo systemctl add-wants getty.target getty@tty1.service" \
		"!      sudo systemctl enable --now getty@tty1.service" \
		"      sudo systemctl daemon-reload" \
		"    VT's getty at boot again. Where kmscon served a VT, skip that VT's" \
		"==> If pacman removed this package to install another vtium console package," \
		"    units again, the links below stay valid, and you do not need to do" \
		"    anything. Otherwise vtium is removed, but these links to vtium's units," \
		"    The kmscon link, for a VT that kmscon served:" \
		"    VT, with sudo systemctl start getty@ttyN.service. Started while vtium" \
		"      sudo ln -s /usr/lib/systemd/system/kmsconvt@.service \\" \
		"!    Next time, run sudo vtium console disable --all before you remove vtium's" \
		"!    install vtium again, run sudo vtium console disable --all, then remove it."

	# vtium console's records outlive the package, and the message names the
	# way to put back exactly what they hold.
	reset
	mkdir -p "$tmp/root/var/lib/vtium/console"
	printf '/usr/lib/systemd/system/getty@.service\n' >"$tmp/root/var/lib/vtium/console/tty3"
	link vtium@.service autovt@tty3.service
	link vtium@.service getty.target.wants/vtium@tty3.service
	expect "$name: the records left behind are named, with the way to put them back" "$(run "$script" post_remove)" \
		"      sudo rm /etc/systemd/system/autovt@tty3.service" \
		"      sudo systemctl add-wants getty.target getty@tty3.service" \
		"    Or put back exactly what vtium console recorded in /var/lib/vtium/console:" \
		"    install vtium again, run sudo vtium console disable --all, then remove it."

	# The getty's own template link is not vtium's to name.
	reset
	link getty@.service autovt@.service
	link vtium@.service autovt@tty3.service
	expect "$name: a template link to the getty is left unnamed" "$(run "$script" post_remove)" \
		"      sudo rm /etc/systemd/system/autovt@tty3.service" \
		"      sudo systemctl add-wants getty.target getty@tty3.service" \
		"!      sudo rm /etc/systemd/system/autovt@.service" \
		"!      sudo systemctl preset getty@.service"

	# A first install claims the free VTs in direct mode with vtium console
	# enable --direct --all, and shows what it said, wrapped to fit 78
	# columns.
	reset
	answer 0 "vtium is enabled in direct mode on every VT from its next start. systemd starts it at boot on VTs 1, 2, 3, 4, 5, and 6, so it holds each of them open from boot." ""
	out=$(run "$script" post_install)
	expect "$name: a first install claims the free VTs and says what vtium console did" "$out" \
		"==> vtium now holds every free VT in direct mode. vtium console enable" \
		"    --direct --all said:" \
		"      vtium is enabled in direct mode on every VT from its next start." \
		"    Nothing was started now. systemd starts vtium at boot on each VT that" \
		"      sudo systemctl start vtium@tty3.service" \
		"      sudo vtium console disable --all" \
		"      sudo vtium console enable --direct 3" \
		"    vtium can also run in seat mode, which is your choice. To see which mode" \
		"      https://github.com/vtium/vtium-arch#sharing-vts-with-kmscon" \
		"status 0" \
		"!      sudo vtium console enable 3" \
		"!==> vtium claimed no VT: vtium console enable --direct --all stopped, and"
	expect "$name: a first install says nothing of a start at the first switch" "$out" \
		"!    the first time you switch to them. vtium console status lists what each"
	# check CASE CONDITION OUTPUT: a case that passes when CONDITION, a
	# command, succeeds, and shows OUTPUT when it fails.
	check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1:"; printf '       %s\n' "${3//$'\n'/$'\n'       }"; fails=$((fails + 1)); fi; }
	check "$name: a first install runs vtium console enable --direct --all and nothing else" '[ "$(calls)" = "console enable --direct --all" ]' "$(calls)"
	check "$name: no line of the install message is longer than 78 columns" '! awk "length > 78" <<<"$out" | grep -q .' "$out"

	# A refused claim never fails the install: it says that vtium claimed no
	# VT, gives vtium console's own reason, and names the command to run once
	# the reason is gone. Each refusal the record names is one case.
	for why in "kmscon holds the template link /etc/systemd/system/autovt@.service, so logind starts kmscon on every VT. To move from kmscon, see the guide." \
		"vtium cannot tell which VTs graphics hold: loginctl list-sessions --no-legend failed: Failed to connect to bus." \
		"this host was not booted with systemd: /run/systemd/system is missing."; do
		reset
		answer 1 "" "vtium console enable --direct --all: $why"
		out=$(run "$script" post_install)
		expect "$name: a refused claim (${why%% *}) says so and the install succeeds" "$out" \
			"==> vtium claimed no VT: vtium console enable --direct --all stopped, and" \
			"      $(printf '%s' "vtium console enable --direct --all: $why" | fold -s -w 72 | head -n1 | sed 's/ *$//')" \
			"    The package is installed all the same. Once the reason is gone, run this" \
			"      sudo vtium console enable --direct --all" \
			"      https://github.com/vtium/vtium-arch#sharing-vts-with-kmscon" \
			"status 0" \
			"!      sudo vtium console disable --all" \
			"!      sudo vtium console enable --all" \
			"!==> vtium now holds every free VT in direct mode. vtium console enable"
	done
	# Any failure of vtium itself is a refused claim too.
	reset
	answer 101 "" "thread 'main' panicked"
	expect "$name: a vtium that crashes during the claim fails no install" "$(run "$script" post_install)" \
		"==> vtium claimed no VT: vtium console enable --direct --all stopped, and" "status 0"

	# Installed in place of another vtium console package whose removal could
	# not give its VTs back, or beside links made by hand, the package finds
	# the links, says the VTs stay vtium's, and claims no other VT.
	reset
	link vtium@.service autovt@tty3.service
	link vtium@.service getty.target.wants/vtium@tty3.service
	expect "$name: install where vtium holds VTs already names them and claims no more" "$(run "$script" post_install)" \
		"==> vtium already holds VTs on this machine, through these links, which an" \
		"      /etc/systemd/system/autovt@tty3.service" \
		"      /etc/systemd/system/getty.target.wants/vtium@tty3.service" \
		"    vtium no other VT:" \
		"status 0" \
		"!==> vtium now holds every free VT in direct mode. vtium console enable" \
		"!==> No running vtium was restarted: a restart ends every session on its VT."
	expect "$name: install where vtium holds VTs already runs no vtium console" "$(calls)" "!console enable --direct --all"
	printf '#!/bin/sh\nprintf "vtium@tty3.service loaded active running vtium on tty3\\n"\n' >"$tmp/bin/systemctl"
	expect "$name: install where vtium holds VTs names the VTs that still run the old build" "$(run "$script" post_install)" \
		"==> vtium already holds VTs on this machine, through these links, which an" \
		"==> No running vtium was restarted: a restart ends every session on its VT." \
		"    These still run the build they started with:" "      vtium@tty3.service"
	rm "$tmp/root/etc/systemd/system/autovt@tty3.service" "$tmp/root/etc/systemd/system/getty.target.wants/vtium@tty3.service"
	expect "$name: install while vtium runs with no link claims the free VTs and names the running VT" "$(run "$script" post_install)" \
		"==> vtium now holds every free VT in direct mode. vtium console enable" \
		"==> No running vtium was restarted: a restart ends every session on its VT." \
		"      vtium@tty3.service" \
		"!==> vtium already holds VTs on this machine, through these links, which an"

	# An upgrade claims nothing and names the VTs whose vtium still runs the
	# old build.
	reset
	printf '#!/bin/sh\nprintf "vtium@tty3.service loaded active running vtium on tty3\\n"\n' >"$tmp/bin/systemctl"
	expect "$name: an upgrade names the running VTs" "$(run "$script" post_upgrade)" \
		"    These still run the build they started with:" "      vtium@tty3.service" "status 0"
	expect "$name: an upgrade runs no vtium console" "$(calls)" "!console enable --direct --all" "!console disable --all"
	check "$name: an upgrade runs no vtium console at all" '[ -z "$(calls)" ]' "$(calls)"

	# A VT in seat mode: its links name vtium-seat@.service, and its unit is
	# vtium-seat@ttyN.service. The removal names each link and the VT's
	# getty, the install finds the links, and the running unit is named.
	reset
	link vtium@.service autovt@.service
	link vtium-seat@.service autovt@tty4.service
	link vtium-seat@.service getty.target.wants/vtium-seat@tty4.service
	link vtium@.service autovt@tty2.service
	link vtium@.service getty.target.wants/vtium@tty2.service
	expect "$name: the links of a VT in seat mode are named with the way back" "$(run "$script" post_remove)" \
		"      sudo rm /etc/systemd/system/autovt@tty4.service" \
		"      sudo rm /etc/systemd/system/getty.target.wants/vtium-seat@tty4.service" \
		"      sudo systemctl add-wants getty.target getty@tty4.service" \
		"      sudo rm /etc/systemd/system/getty.target.wants/vtium@tty2.service" \
		"      sudo systemctl add-wants getty.target getty@tty2.service"
	expect "$name: install where vtium holds a VT in seat mode names its links and claims no more" "$(run "$script" post_install)" \
		"==> vtium already holds VTs on this machine, through these links, which an" \
		"      /etc/systemd/system/autovt@tty4.service" \
		"      /etc/systemd/system/getty.target.wants/vtium-seat@tty4.service" \
		"!==> vtium now holds every free VT in direct mode. vtium console enable"
	check "$name: install where vtium holds a VT in seat mode runs no vtium console" '[ -z "$(calls)" ]' "$(calls)"
	printf '#!/bin/sh\nprintf "vtium-seat@tty4.service loaded active running vtium on tty4\\n"\n' >"$tmp/bin/systemctl"
	expect "$name: an upgrade names a running vtium in seat mode" "$(run "$script" post_upgrade)" \
		"    These still run the build they started with:" "      vtium-seat@tty4.service"
	expect "$name: a removal while vtium runs in seat mode names it and its link" "$(run "$script" pre_remove)" \
		"      vtium-seat@tty4.service" \
		"    A VT whose link still names one of vtium's units then has no console"
	rm "$tmp/root/etc/systemd/system/autovt@.service" "$tmp/root/etc/systemd/system/autovt@tty2.service" \
		"$tmp/root/etc/systemd/system/getty.target.wants/vtium@tty2.service" "$tmp/root/etc/systemd/system/autovt@tty4.service"
	expect "$name: a want at boot in seat mode alone is still a link to vtium" "$(run "$script" post_remove)" \
		"      sudo rm /etc/systemd/system/getty.target.wants/vtium-seat@tty4.service"

	# An upgrade on a machine where vtium holds the VTs through the template
	# link alone, as an install before vtium started at boot left it, says
	# which VTs from 2 to 5 nothing holds open at boot and names the command
	# that starts vtium at boot on them. It changes no VT.
	reset
	link vtium@.service autovt@.service
	link getty@.service getty.target.wants/getty@tty1.service
	out=$(run "$script" post_upgrade)
	expect "$name: an upgrade of a machine claimed through the template link alone says vtium does not start at boot" "$out" \
		"==> vtium does not start at boot on VTs 2, 3, 4, and 5. It holds them through" \
		"      sudo vtium console enable --direct --all" \
		"status 0"
	check "$name: the note at an upgrade runs no vtium console" '[ -z "$(calls)" ]' "$(calls)"
	check "$name: no line of the upgrade's note is longer than 78 columns" '! awk "length > 78" <<<"$out" | grep -q .' "$out"
	# A VT with its own link or a want at boot is held, so only the others
	# are named.
	link vtium@.service autovt@tty2.service
	link vtium@.service getty.target.wants/vtium@tty2.service
	link vtium@.service getty.target.wants/vtium@tty3.service
	ln -s /usr/lib/systemd/system/kmsconvt@.service "$tmp/root/etc/systemd/system/autovt@tty4.service"
	expect "$name: the note at an upgrade names only the VTs nothing holds at boot" "$(run "$script" post_upgrade)" \
		"==> vtium does not start at boot on VT 5. It holds it through the template" \
		"      sudo vtium console enable --direct --all"
	# In seat mode the command names seat mode.
	rm "$tmp/root/etc/systemd/system/autovt@.service"
	link vtium-seat@.service autovt@.service
	expect "$name: the note at an upgrade in seat mode names seat mode" "$(run "$script" post_upgrade)" \
		"      sudo vtium console enable --seat --all" \
		"!      sudo vtium console enable --direct --all"
	# A machine claimed with a want at boot on each VT from 2 to 5 gets no
	# note.
	reset
	link vtium@.service autovt@.service
	for n in 2 3 4 5; do link vtium@.service "getty.target.wants/vtium@tty$n.service"; done
	expect "$name: an upgrade of a machine claimed with wants at boot says nothing of the boot" "$(run "$script" post_upgrade)" \
		"!      sudo vtium console enable --direct --all" "status 0"
	# Nor does a machine whose template link is not vtium's.
	reset
	link getty@.service autovt@.service
	expect "$name: an upgrade of a machine vtium does not hold says nothing of the boot" "$(run "$script" post_upgrade)" \
		"!      sudo vtium console enable --direct --all" "status 0"
	# The install over links an earlier install left gives the same note.
	reset
	link vtium@.service autovt@.service
	expect "$name: install over a template link alone says vtium does not start at boot" "$(run "$script" post_install)" \
		"==> vtium already holds VTs on this machine, through these links, which an" \
		"==> vtium does not start at boot on VTs 2, 3, 4, and 5. It holds them through" \
		"      sudo vtium console enable --direct --all"

	# A removal gives the VTs back with vtium console disable --all before the
	# package's files go, and says what vtium console did.
	reset
	answer 0 "vtium is disabled on every VT it was given. Each VT gets back what it had." ""
	expect "$name: a removal gives the VTs back" "$(run "$script" pre_remove)" \
		"==> vtium gave the VTs back. vtium console disable --all said:" \
		"      vtium is disabled on every VT it was given. Each VT gets back what it" \
		"    package, that package gives vtium the free VTs again when it installs." \
		"status 0" \
		"!==> vtium gave no VT back: vtium console disable --all stopped, and said:"
	expect "$name: a removal runs vtium console disable --all" "$(calls)" "console disable --all" "!console enable --all"
	# A refused give-back never fails the removal.
	answer 1 "" "vtium console disable --all: this host was not booted with systemd: /run/systemd/system is missing."
	expect "$name: a refused give-back says so and the removal succeeds" "$(run "$script" pre_remove)" \
		"==> vtium gave no VT back: vtium console disable --all stopped, and said:" \
		"      vtium console disable --all: this host was not booted with systemd:" \
		"    The package is removed all the same. pacman lists the links to vtium" \
		"status 0"

	# A removal while vtium runs names the running VTs, and says a VT has no
	# console unit only while a link to vtium@.service is left.
	reset
	printf '#!/bin/sh\nprintf "vtium@tty3.service loaded active running vtium on tty3\\n"\n' >"$tmp/bin/systemctl"
	expect "$name: a removal while vtium runs, with no link left, names the VT and no missing unit" "$(run "$script" pre_remove)" \
		"      vtium@tty3.service" \
		"    sudo systemctl stop vtium@ttyN.service stops one, which ends every" \
		"!    A VT whose link still names one of vtium's units then has no console"
	link vtium@.service autovt@tty3.service
	expect "$name: a removal while vtium runs, with a link left, says that VT has no console unit" "$(run "$script" pre_remove)" \
		"      vtium@tty3.service" \
		"    A VT whose link still names one of vtium's units then has no console" \
		"    this package to install another vtium console package, that package"
done
# Every console package carries the same install text as vtium.
for script in "${scripts[@]}"; do
	name=${script#"$here/"}
	[ "$name" != vtium/vtium.install ] || continue
	if cmp -s "$script" "$here/vtium/vtium.install"; then
		echo "ok   $name carries the same install text as vtium/vtium.install"
	else
		echo "FAIL $name differs from vtium/vtium.install"
		fails=$((fails + 1))
	fi
done

if [ "$fails" = 0 ]; then echo "test-install-messages: every case passed"; else echo "test-install-messages: $fails case(s) failed" >&2; exit 1; fi
