#!/bin/bash
# Pushes one package directory of this repository to its AUR repository,
# ssh://aur@aur.archlinux.org/<pkgname>.git, as the root of that repository's
# master branch.
#
#   ./aur-publish [--dry-run] DIR
#
# The push goes out under the SSH key of whoever runs it, so the maintainer
# runs it, after review. Before it pushes, it checks that:
#   - DIR is a package directory: its name is the pkgbase in its .SRCINFO,
#     and it holds PKGBUILD, .SRCINFO and LICENSE;
#   - DIR has no change that is not committed, since only commits are pushed;
#   - the committed .SRCINFO is what makepkg --printsrcinfo prints, run with
#     VTIUM_GIT_URL and VTIUM_GIT_BRANCH unset;
#   - no checksum is a placeholder;
#   - each git source pinned to a tag names a tag its repository has, so a
#     release package waits for its tag, and a source with ?signed names a
#     tag signed by one of validpgpkeys' keys, checked against the key files
#     in DIR/keys/pgp alone, in a keyring of its own;
#   - the steps a release recipe and its -git twin share, such as
#     vtium/PKGBUILD and vtium-git/PKGBUILD, everything from the line
#     "# Everything below is the same", are the same in both, and so is
#     every other file both carry, such as LICENSE and a frit;
#   - every commit the AUR receives holds PKGBUILD and .SRCINFO, which the
#     AUR asks of each commit.
# The commits are DIR's history, split out with git subtree split --prefix
# DIR, so each push carries on from the last. --dry-run runs every check and
# prints the push without running it.
set -euo pipefail

die() {
	printf 'aur-publish: %s\n' "$*" >&2
	exit 1
}
usage() {
	sed -n '6,6s/^# \{0,1\}//p' "$0" >&2
	exit 2
}

dry=
dir=
while [ $# -gt 0 ]; do
	case $1 in
	--dry-run) dry=1 ;;
	-h | --help) usage ;;
	-*) usage ;;
	*) [ -z "$dir" ] || usage; dir=$1 ;;
	esac
	shift
done
[ -n "$dir" ] || usage

top=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$top"
dir=${dir%/}
[[ $dir =~ ^[a-z0-9][a-z0-9._+-]*$ ]] || die "'$dir' is not a package directory at the top of $top"
for f in PKGBUILD .SRCINFO LICENSE; do
	[ -f "$dir/$f" ] || die "$dir has no $f"
done
pkgbase=$(sed -n 's/^pkgbase = //p' "$dir/.SRCINFO")
[ "$pkgbase" = "$dir" ] || die "$dir/.SRCINFO names pkgbase '$pkgbase', not '$dir'"

[ -z "$(git status --porcelain -- "$dir")" ] ||
	die "$dir has changes that are not committed; commit them first, since only commits are pushed"

srcinfo=$(cd "$dir" && env -u VTIUM_GIT_URL -u VTIUM_GIT_BRANCH makepkg --printsrcinfo) ||
	die "makepkg --printsrcinfo failed in $dir"
[ "$srcinfo" = "$(git show "HEAD:$dir/.SRCINFO")" ] ||
	die "$dir/.SRCINFO is not what makepkg --printsrcinfo prints; run it again and commit: (cd $dir && makepkg --printsrcinfo > .SRCINFO)"

# A placeholder checksum is one that is no checksum: words such as
# PLACEHOLDER or FIXME, or a sum of zeros.
if grep -E '^[[:space:]]*(md5|sha1|sha224|sha256|sha384|sha512|b2)sums = ' "$dir/.SRCINFO" |
	grep -qiE '= (.*placeholder.*|.*fixme.*|.*todo.*|0+)$'; then
	die "$dir/.SRCINFO holds a placeholder checksum; fill it in with updpkgsums once the source exists"
fi

# A release recipe and its -git twin, such as vtium and vtium-git, share
# their steps, and those must not drift apart. A recipe whose twin is not in
# this repository has nothing to compare.
shared() { sed -n '/^# Everything below is the same/,$p' "$1"; }
case $dir in
*-git) other=${dir%-git} ;;
*) other=$dir-git ;;
esac
if [ -f "$other/PKGBUILD" ]; then
	[ -n "$(shared "$dir/PKGBUILD")" ] || die "$dir/PKGBUILD has no line '# Everything below is the same' before the steps it shares with $other"
	[ "$(shared "$dir/PKGBUILD")" = "$(shared "$other/PKGBUILD")" ] ||
		die "the steps $dir/PKGBUILD shares with $other/PKGBUILD differ; make them the same in both"
	# Every other file both twins carry, such as LICENSE and a frit, is the
	# same in both.
	for f in "$dir"/* "$dir"/.gitignore; do
		b=${f##*/}
		case $b in PKGBUILD | .SRCINFO) continue ;; esac
		[ -f "$f" ] && [ -f "$other/$b" ] || continue
		cmp -s "$f" "$other/$b" || die "$dir/$b and $other/$b differ; make them the same in both"
	done
fi

# A scratch directory for the tag checks: a bare repository to fetch each
# tag into and a keyring that holds only DIR's key files. git and gpg read
# no configuration of the user's and start no agent, so they never reach the
# user's own keys or ask for a passphrase.
scratch=$(mktemp -d) || die "cannot create a scratch directory"
cleanup() {
	gpgconf --homedir "$scratch/gnupg" --kill all >/dev/null 2>&1 || true
	rm -rf -- "$scratch"
}
trap cleanup EXIT
tagcheck() {
	GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GNUPGHOME=$scratch/gnupg git -C "$scratch/repo" "$@"
}
mkdir -m 0700 "$scratch/gnupg"
printf 'no-autostart\n' >"$scratch/gnupg/gpg.conf"
GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git init -q --bare "$scratch/repo"
mapfile -t keys < <(sed -n 's/^[[:space:]]*validpgpkeys = //p' "$dir/.SRCINFO")
for k in "${keys[@]}"; do
	[ -f "$dir/keys/pgp/$k.asc" ] || die "$dir names the key $k in validpgpkeys but holds no $dir/keys/pgp/$k.asc"
	GNUPGHOME=$scratch/gnupg gpg --batch --quiet --import "$dir/keys/pgp/$k.asc" 2>/dev/null ||
		die "$dir/keys/pgp/$k.asc is not a key gpg can import"
done
# Each git source pinned to a tag must name a tag its repository has, and
# one with ?signed a tag that a key of validpgpkeys signed.
while read -r url tag query; do
	tagcheck fetch -q --no-tags "$url" "refs/tags/$tag:refs/tags/$tag" 2>/dev/null ||
		die "$dir builds from tag $tag of $url, which has no such tag yet; publish $dir once the tag is pushed"
	[[ $query == *signed* ]] || continue
	[ ${#keys[@]} -gt 0 ] || die "$dir checks the signature of tag $tag but names no key in validpgpkeys"
	[ "$(tagcheck cat-file -t "refs/tags/$tag")" = tag ] ||
		die "tag $tag of $url is a lightweight tag, which carries no signature"
	signer=$(tagcheck verify-tag --raw "$tag" 2>&1 | awk '$2 == "VALIDSIG" { print $NF }') || true
	[ -n "$signer" ] || die "tag $tag of $url carries no good signature by a key in $dir/keys/pgp"
	printf '%s\n' "${keys[@]}" | grep -qxF "$signer" ||
		die "tag $tag of $url is signed by $signer, which is not in $dir's validpgpkeys"
	echo "aur-publish: tag $tag of $url is signed by $signer."
done < <(sed -n 's/^[[:space:]]*source = \(.*::\)\{0,1\}git+\([^#?]*\)#tag=\([^?]*\)\(.*\)/\2 \3 \4/p' "$dir/.SRCINFO")

split=$(git subtree split --prefix "$dir" HEAD 2>/dev/null) || die "git subtree split --prefix $dir failed"
for c in $(git rev-list "$split"); do
	for f in PKGBUILD .SRCINFO; do
		git cat-file -e "$c:$f" 2>/dev/null ||
			die "commit $(git rev-parse --short "$c") of $dir's history has no $f, and the AUR refuses such a commit"
	done
done

remote=ssh://aur@aur.archlinux.org/$pkgbase.git
echo "aur-publish: $dir passes every check; its history is $(git rev-list --count "$split") commits, ending at $(git rev-parse --short "$split")."
if [ -n "$dry" ]; then
	printf 'aur-publish: the push, not run:\n  git push %q %s:refs/heads/master\n' "$remote" "$split"
	exit 0
fi
git push "$remote" "$split:refs/heads/master"
